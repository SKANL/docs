  "journey": {
    "status": "closest-real-journey",
    "test": "tests/integration/test_v2_end_to_end.py::test_v2_public_journey_creates_prepares_builds_verifies_packages_and_publishes",
    "covered": [
      "document create",
      "source ingest",
      "source prepare",
      "verified v2 build",
      "standalone verify",
      "deterministic package",
      "policy-gated publish"
    ],
    "gap": "Creation remains an explicit user action; `document release` composes the complete verified build, package, and publication pipeline for the active document. The acceptance test invokes the real commands in sequence against one temporary workspace and uses a deterministic in-test ingest adapter and DOCX renderer because optional external renderers are environment-dependent."
  },

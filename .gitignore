# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Knowledge-graph indexes (generated; rebuilt by their own watchers/hooks)
graphify-out/

# Harness-managed scratch state (agent git worktrees live under here and
# hold a full second copy of the tree — ruff/pytest must not walk them).
.claude/

# Coverage artefacts
.coverage
.coverage.*
htmlcov/

# Per-machine workspace pointer written by `docs doc init`. It holds absolute
# paths to someone's documents dir — committing it leaks a local path and
# breaks every other checkout.
docs.config.json

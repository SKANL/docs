{
  "name": "docs-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "sync:review-studio": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-review-studio.ps1",
    "test:shell": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-shell.ps1",
    "check:sidecar": "python scripts/check-sidecar-packaging.py",
    "test:sidecar": "npm run check:sidecar && npm run check:sidecar:runtime && npm run check:sidecar:e2e",
    "test:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-installer.ps1",
    "check:sidecar:runtime": "python scripts/check-sidecar-runtime.py",
    "check:sidecar:e2e": "python scripts/check-sidecar-e2e.py",
    "test:real-pdf": "python scripts/check-real-pdf-e2e.py",
    "release:update-manifest": "python scripts/generate-update-manifest.py",
    "build:sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1",
    "build": "tauri build",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-windows.ps1",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-shell.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
